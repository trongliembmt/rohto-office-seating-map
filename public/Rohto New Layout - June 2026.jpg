<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2000 1414" width="2000" height="1414" style="background:#ffffff; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <defs>
    <!-- Architectural grid -->
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#f1f5f9" stroke-width="1"/>
    </pattern>
    <pattern id="hatch" width="10" height="10" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="10" stroke="#cbd5e1" stroke-width="2" />
    </pattern>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="4" flood-opacity="0.1" />
    </filter>
  </defs>

  <rect width="2000" height="1414" fill="#ffffff" />
  <rect width="2000" height="1414" fill="url(#grid)" />

  <!-- Outer Building Boundary Envelope (Exact Rohto Hex-Triangle Footprint) -->
  <g stroke="#0f172a" stroke-width="4" fill="#ffffff">
    <polygon points="980,60 1280,65 1680,440 1480,1350 1120,1350 800,1320 280,740 470,340 680,340 980,60" />
  </g>

  <!-- Structural Columns with Rings -->
  <g fill="#475569" stroke="#0f172a" stroke-width="3">
    <!-- North & East -->
    <circle cx="1280" cy="85" r="20" /><circle cx="1280" cy="85" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="1680" cy="480" r="20" /><circle cx="1680" cy="480" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <!-- South & West -->
    <circle cx="1480" cy="1330" r="20" /><circle cx="1480" cy="1330" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="1120" cy="1340" r="20" /><circle cx="1120" cy="1340" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="800" cy="1320" r="20" /><circle cx="800" cy="1320" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="290" cy="740" r="20" /><circle cx="290" cy="740" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="490" cy="340" r="20" /><circle cx="490" cy="340" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
    <circle cx="620" cy="920" r="20" /><circle cx="620" cy="920" r="28" fill="none" stroke="#94a3b8" stroke-width="1.5" />
  </g>

  <!-- Central Building Core (Rotated Angle) -->
  <g transform="translate(890, 680) rotate(-15)">
    <!-- Core Boundary -->
    <polygon points="-130,-230 130,-230 230,-40 200,230 -15,260 -210,90 -200,-100" fill="#f8fafc" stroke="#1e293b" stroke-width="4" />
    <polygon points="-115,-215 115,-215 210,-30 180,215 -10,245 -190,80 -180,-90" fill="none" stroke="#64748b" stroke-width="2" stroke-dasharray="6,6" />

    <!-- Elevator Lobby & Elevators L5 to L12 -->
    <rect x="-90" y="-40" width="180" height="220" fill="#f1f5f9" stroke="#475569" stroke-width="3" />
    <text x="0" y="10" font-size="14" font-weight="800" fill="#1e293b" text-anchor="middle" letter-spacing="1">ELEVATOR LOBBY</text>
    
    <!-- Lifts -->
    <g fill="#ffffff" stroke="#334155" stroke-width="2" font-size="13" font-weight="700" text-anchor="middle">
      <rect x="-80" y="30" width="34" height="34" /><text x="-63" y="52">L10</text>
      <rect x="-40" y="30" width="34" height="34" /><text x="-23" y="52">L9</text>
      <rect x="0" y="30" width="34" height="34" /><text x="17" y="52">L8</text>
      <rect x="40" y="30" width="34" height="34" /><text x="57" y="52">L7</text>

      <rect x="-80" y="75" width="55" height="45" /><text x="-52" y="103">L12</text>
      <rect x="-18" y="75" width="55" height="45" /><text x="10" y="103">L11</text>
      <rect x="45" y="75" width="32" height="45" /><text x="61" y="103">L6</text>
      <rect x="45" y="130" width="32" height="45" /><text x="61" y="158">L5</text>
    </g>

    <!-- Restrooms (WC) -->
    <g stroke="#64748b" stroke-width="2">
      <rect x="-190" y="-70" width="90" height="130" fill="#ffffff" />
      <text x="-145" y="-40" font-size="12" font-weight="700" fill="#334155" text-anchor="middle">FEMALE WC</text>
      <text x="-145" y="25" font-size="12" font-weight="700" fill="#334155" text-anchor="middle">MALE WC</text>
      <text x="-145" y="-5" font-size="10" font-weight="600" fill="#64748b" text-anchor="middle">HAND DRY</text>
    </g>

    <!-- Engine Room -->
    <rect x="-40" y="-200" width="140" height="100" fill="url(#hatch)" stroke="#334155" stroke-width="2" />
    <rect x="-25" y="-165" width="110" height="30" rx="4" fill="#ffffff" stroke="#64748b" />
    <text x="30" y="-145" font-size="13" font-weight="800" fill="#0f172a" text-anchor="middle">ENGINE ROOM</text>
  </g>

  <!-- RECEPTION & LOBBY ENTRANCE -->
  <g transform="translate(820, 440)">
    <text x="0" y="0" font-size="14" font-weight="800" fill="#1e293b">RECEPTION</text>
    <text x="0" y="20" font-size="11" font-weight="600" fill="#64748b">Kh.Vy · VÁCH LOGO SANH</text>
  </g>

  <!-- ================= MEETING ROOMS (Labeled with exact colored capsules) ================= -->

  <!-- Osaka Room (Orange Capsule) -->
  <g transform="translate(810, 310)">
    <rect x="-70" y="-50" width="140" height="100" rx="12" fill="#fff7ed" stroke="#ea580c" stroke-width="4" />
    <rect x="-35" y="-25" width="70" height="50" rx="16" fill="#fdba74" opacity="0.6" stroke="#ea580c" stroke-width="2" />
    <text x="0" y="5" font-size="15" font-weight="800" fill="#c2410c" text-anchor="middle" transform="rotate(-90)">Osaka room</text>
  </g>

  <!-- Saigon Room (Pink Capsule) -->
  <g transform="translate(680, 400)">
    <rect x="-50" y="-70" width="100" height="140" rx="12" fill="#fdf2f8" stroke="#db2777" stroke-width="4" />
    <rect x="-25" y="-40" width="50" height="80" rx="18" fill="#f472b6" opacity="0.6" stroke="#db2777" stroke-width="2" />
    <text x="0" y="5" font-size="15" font-weight="800" fill="#be185d" text-anchor="middle" transform="rotate(-75)">Saigon room</text>
  </g>

  <!-- Da Nang Room (Magenta Capsule) -->
  <g transform="translate(690, 600)">
    <rect x="-55" y="-35" width="110" height="70" rx="12" fill="#fdf4ff" stroke="#c026d3" stroke-width="4" />
    <text x="0" y="6" font-size="14" font-weight="800" fill="#a21caf" text-anchor="middle">Da Nang room</text>
  </g>

  <!-- Tokyo Room (Top Right - Blue Capsule) -->
  <g transform="translate(1340, 230)">
    <rect x="-65" y="-35" width="130" height="70" rx="12" fill="#eff6ff" stroke="#2563eb" stroke-width="4" />
    <text x="0" y="6" font-size="15" font-weight="800" fill="#1d4ed8" text-anchor="middle">Tokyo room</text>
  </g>

  <!-- Fujisan Room (Purple Capsule) -->
  <g transform="translate(1410, 350)">
    <rect x="-65" y="-30" width="130" height="60" rx="12" fill="#faf5ff" stroke="#7e22ce" stroke-width="4" />
    <text x="0" y="5" font-size="14" font-weight="800" fill="#6b21a8" text-anchor="middle">Fujisan room</text>
  </g>

  <!-- Hanoi Room (Green Capsule) -->
  <g transform="translate(1360, 440)">
    <rect x="-70" y="-35" width="140" height="70" rx="12" fill="#f0fdf4" stroke="#16a34a" stroke-width="4" />
    <text x="0" y="6" font-size="15" font-weight="800" fill="#15803d" text-anchor="middle">Hanoi room</text>
  </g>

  <!-- Kyoto Room (Teal Capsule) -->
  <g transform="translate(1390, 570)">
    <rect x="-55" y="-45" width="110" height="90" rx="12" fill="#ecfeff" stroke="#0891b2" stroke-width="4" />
    <text x="0" y="6" font-size="15" font-weight="800" fill="#0e7490" text-anchor="middle">Kyoto room</text>
  </g>

  <!-- ================= 5 MAIN DEPARTMENTS ================= -->

  <!-- 1. SALE DEPARTMENT (Left Wing - Blue outline) -->
  <g>
    <!-- Zone Boundary Line -->
    <path d="M 470,270 C 380,260 340,340 340,440 C 340,510 300,580 250,680 C 230,750 280,790 340,760 L 580,920 C 610,930 640,910 630,860 L 520,680 L 630,610 L 640,470 L 560,370 Z" 
      fill="#eff6ff" fill-opacity="0.4" stroke="#2563eb" stroke-width="5" stroke-dasharray="10,6" />

    <!-- Department Title Banner -->
    <g transform="translate(540, 610)">
      <rect x="-85" y="-24" width="170" height="48" rx="24" fill="#2563eb" filter="url(#shadow)" />
      <text x="0" y="8" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="2">SALE</text>
    </g>

    <!-- Detailed Desks pods in Sale -->
    <g fill="#ffffff" stroke="#64748b" stroke-width="2">
      <!-- 4x2 Desk Pods -->
      <rect x="410" y="300" width="115" height="55" rx="4" />
      <rect x="540" y="300" width="70" height="55" rx="4" />
      <rect x="400" y="380" width="115" height="55" rx="4" />
      <rect x="530" y="380" width="115" height="55" rx="4" />
      <rect x="330" y="480" width="115" height="60" rx="4" />
      <rect x="460" y="480" width="115" height="60" rx="4" />
      <rect x="315" y="580" width="120" height="60" rx="4" />
      <rect x="450" y="580" width="120" height="60" rx="4" />
      <rect x="500" y="700" width="130" height="70" rx="4" />
      <rect x="540" y="780" width="130" height="70" rx="4" />
      <!-- Round discussion table B10 -->
      <circle cx="680" cy="890" r="26" fill="#e2e8f0" stroke="#64748b" stroke-width="2" />
      <text x="680" y="895" font-size="13" font-weight="700" fill="#334155" text-anchor="middle">B10</text>
    </g>
  </g>

  <!-- 2. MARKETING DEPARTMENT (Bottom-Left Wing - Green outline) -->
  <g>
    <!-- Zone Boundary Line -->
    <path d="M 620,900 L 730,1060 L 800,1260 L 960,1350 L 990,1300 L 900,1080 L 800,950 L 640,880 Z" 
      fill="#f0fdf4" fill-opacity="0.4" stroke="#16a34a" stroke-width="5" stroke-dasharray="10,6" />

    <!-- Department Title Banner -->
    <g transform="translate(640, 1180)">
      <rect x="-115" y="-24" width="230" height="48" rx="24" fill="#16a34a" filter="url(#shadow)" />
      <text x="0" y="8" font-size="20" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">MARKETING</text>
    </g>

    <!-- General Director Office -->
    <g transform="translate(890, 1275)">
      <rect x="-80" y="-35" width="160" height="70" rx="6" fill="#dcfce7" stroke="#15803d" stroke-width="3" />
      <text x="0" y="6" font-size="13" font-weight="800" fill="#166534" text-anchor="middle">GENERAL DIRECTOR</text>
    </g>

    <!-- Desk pods in Marketing -->
    <g fill="#ffffff" stroke="#64748b" stroke-width="2">
      <rect x="635" y="940" width="115" height="60" rx="4" />
      <rect x="680" y="1025" width="120" height="60" rx="4" />
      <rect x="720" y="1110" width="120" height="60" rx="4" />
      <rect x="770" y="1195" width="120" height="60" rx="4" />
    </g>
  </g>

  <!-- 3. ADMIN DEPARTMENT (Bottom-Right Wing - Yellow outline) -->
  <g>
    <!-- Zone Boundary Line -->
    <path d="M 970,970 L 1190,1040 L 1400,1350 L 1120,1360 L 960,1110 Z" 
      fill="#fefce8" fill-opacity="0.4" stroke="#ca8a04" stroke-width="5" stroke-dasharray="10,6" />

    <!-- Department Title Banner -->
    <g transform="translate(1340, 1100)">
      <rect x="-85" y="-24" width="170" height="48" rx="24" fill="#ca8a04" filter="url(#shadow)" />
      <text x="0" y="8" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="2">ADMIN</text>
    </g>

    <!-- Desk pods in Admin with dimension lines -->
    <g fill="#ffffff" stroke="#64748b" stroke-width="2">
      <rect x="1000" y="1025" width="130" height="70" rx="4" />
      <rect x="1060" y="1125" width="130" height="70" rx="4" />
      <rect x="1000" y="1225" width="115" height="60" rx="4" />
      <rect x="1140" y="1225" width="115" height="60" rx="4" />
      <!-- Pantry & Technical storage -->
      <rect x="960" y="1040" width="30" height="85" fill="#fed7aa" stroke="#f97316" stroke-width="2" />
      <text x="975" y="1090" font-size="11" font-weight="800" fill="#9a3412" text-anchor="middle" transform="rotate(-90 975 1090)">PANTRY</text>
    </g>
  </g>

  <!-- 4. MARKET DEVELOP (Middle-Right Wing - Red outline) -->
  <g>
    <!-- Zone Boundary Line -->
    <path d="M 1260,740 L 1460,750 L 1500,920 L 1320,950 L 1240,840 Z" 
      fill="#fef2f2" fill-opacity="0.4" stroke="#dc2626" stroke-width="5" stroke-dasharray="10,6" />

    <!-- Department Title Banner -->
    <g transform="translate(1560, 890)">
      <rect x="-135" y="-24" width="270" height="48" rx="24" fill="#dc2626" filter="url(#shadow)" />
      <text x="0" y="8" font-size="19" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="1">MARKET DEVELOP</text>
    </g>

    <!-- Desk pods in Market Develop -->
    <g fill="#ffffff" stroke="#64748b" stroke-width="2">
      <rect x="1300" y="755" width="120" height="70" rx="4" />
      <rect x="1340" y="840" width="120" height="70" rx="4" />
    </g>
  </g>

  <!-- 5. FINANCE DEPARTMENT (Top-Right Wing - Sky Blue outline) -->
  <g>
    <!-- Zone Boundary Line -->
    <path d="M 1470,450 L 1650,520 L 1460,750 L 1400,720 L 1470,580 Z" 
      fill="#f0f9ff" fill-opacity="0.4" stroke="#0284c7" stroke-width="5" stroke-dasharray="10,6" />

    <!-- Department Title Banner -->
    <g transform="translate(1630, 650)">
      <rect x="-95" y="-24" width="190" height="48" rx="24" fill="#0284c7" filter="url(#shadow)" />
      <text x="0" y="8" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="2">FINANCE</text>
    </g>

    <!-- Desk pods in Finance -->
    <g fill="#ffffff" stroke="#64748b" stroke-width="2">
      <rect x="1500" y="480" width="115" height="60" rx="4" />
      <rect x="1465" y="565" width="115" height="60" rx="4" />
      <rect x="1430" y="650" width="115" height="60" rx="4" />
    </g>
  </g>

  <!-- Dimension Annotation Lines (Matching CAD Blueprint) -->
  <g stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3" font-size="11" fill="#64748b" font-weight="700">
    <line x1="980" y1="990" x2="1140" y2="990" /><text x="1060" y="985" text-anchor="middle">1400</text>
    <line x1="1140" y1="990" x2="1280" y2="990" /><text x="1210" y="985" text-anchor="middle">1416</text>
    <line x1="1280" y1="990" x2="1400" y2="990" /><text x="1340" y="985" text-anchor="middle">1400</text>
    <line x1="1400" y1="990" x2="1490" y2="990" /><text x="1445" y="985" text-anchor="middle">917</text>
  </g>

  <!-- Architectural Title & Legend Badge -->
  <g transform="translate(90, 110)">
    <rect x="0" y="0" width="380" height="120" rx="14" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" filter="url(#shadow)" />
    <text x="30" y="42" font-size="24" font-weight="900" fill="#0f172a" letter-spacing="1">ROHTO NEW LAYOUT</text>
    <text x="30" y="72" font-size="15" font-weight="700" fill="#475569">Floor Plan Architectural Blueprint (1:1 Natural Scale)</text>
    <text x="30" y="100" font-size="14" font-weight="800" fill="#0284c7">JUNE 2026 EDITION · HIGH RESOLUTION CAD</text>
  </g>
</svg>
